{
  "name": "LesteShop",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install -e '.[dev,app]' && python -m pytest -q",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "mechatronics3d.vscode-sqlite"
      ]
    },
    "codespaces": {
      "openFiles": [
        "docs/testar_no_navegador.md"
      ]
    }
  },
  "forwardPorts": [
    8501
  ],
  "portsAttributes": {
    "8501": {
      "label": "App LesteShop",
      "onAutoForward": "openBrowser"
    }
  }
}
